    { "source": "/products", "destination": "/products.html" },

    { "source": "/404", "destination": "/404.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/account-address", "destination": "/account-address.html" },
    { "source": "/account-addresses", "destination": "/account-addresses.html" },
    { "source": "/account-dashboard", "destination": "/account-dashboard.html" },
    { "source": "/account-details", "destination": "/account-details.html" },
    { "source": "/account-download", "destination": "/account-download.html" },
    { "source": "/account-order", "destination": "/account-order.html" },
    { "source": "/account-order-details", "destination": "/account-order-details.html" },
    { "source": "/account-wishlist", "destination": "/account-wishlist.html" },
    { "source": "/blog-single", "destination": "/blog-single.html" },
    { "source": "/cancellation-policy", "destination": "/cancellation-policy.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/corporate-compliance", "destination": "/corporate-compliance.html" },
    { "source": "/delivery-policy", "destination": "/delivery-policy.html" },
    { "source": "/faqs", "destination": "/faqs.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/order-received", "destination": "/order-received.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/product-single", "destination": "/product-single.html" },
    { "source": "/refund-return", "destination": "/refund-return.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/term-condition", "destination": "/term-condition.html" },
    { "source": "/testimonials", "destination": "/testimonials.html" }
  ]
}
