{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/product/:slug", "destination": "/product-single.html" },
    { "source": "/category/:slug", "destination": "/products.html" },
    { "source": "/tag/:tag", "destination": "/products.html" },
    { "source": "/blog/:slug", "destination": "/blog-single.html" },
    { "source": "/account/orders/:id", "destination": "/account-order-details.html" },
